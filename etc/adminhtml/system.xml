<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="c0defusi0n" translate="label" sortOrder="100">
            <label>C0DEFUSI0N</label>
        </tab>
        <section id="security_scanner" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Security Scanner</label>
            <tab>c0defusi0n</tab>
            <resource>Magento_Backend::admin</resource>

            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Configuration</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Scanner</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="scan_frequency" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Scan Frequency</label>
                    <source_model>C0defusi0n\SecurityScanner\Model\Config\Source\ScanFrequency</source_model>
                    <comment>How often the scanner should run.</comment>
                </field>
                <field id="ignore_list" translate="label" type="textarea" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Ignore List</label>
                    <comment>One entry per line. Any finding whose location (CMS identifier, config path, media path...) contains an entry is ignored. Use to silence known false positives.</comment>
                </field>
            </group>

            <group id="email_notification" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Email Notifications</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Email Notifications</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="email_sender" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Email Sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="recipients" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Email Recipients</label>
                    <comment>Separate multiple email addresses with commas.</comment>
                    <validate>validate-emails</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="send_clean_report" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send Clean Reports</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Send a report even if no malicious code is detected.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="telegram_notification" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Telegram Notifications</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Telegram Notifications</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="bot_token" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Telegram Bot Token</label>
                    <comment>The API token of your Telegram bot.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="chat_id" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Telegram Chat ID</label>
                    <comment>Chat ID or comma-separated IDs where the bot should send notifications.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="send_clean_report" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send Clean Reports</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Send a report even if no malicious code is detected.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="test_button" translate="label" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Test Telegram Connection</label>
                    <frontend_model>C0defusi0n\SecurityScanner\Block\Adminhtml\System\Config\TestButton</frontend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="webhook_notification" translate="label" type="text" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Webhook Notifications</label>
                <comment>Generic incoming webhook (Slack, Discord, Mattermost, Microsoft Teams, Google Chat...). The message is POSTed as JSON.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Webhook Notifications</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="url" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Webhook URL</label>
                    <comment>The incoming webhook URL to POST notifications to.</comment>
                    <validate>validate-url</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="send_clean_report" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send Clean Reports</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Send a report even if no malicious code is detected.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="test_button" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Test Webhook</label>
                    <frontend_model>C0defusi0n\SecurityScanner\Block\Adminhtml\System\Config\WebhookTestButton</frontend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="ai_scanner" translate="label" type="text" sortOrder="38" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>AI Scanner (optional)</label>
                <comment>Send scanned content (CMS blocks/pages, HTML config) to an OpenAI-compatible LLM for a second opinion alongside the regex patterns. Works with a local model (Ollama, LM Studio, vLLM, llama.cpp) or an external API (OpenAI, ...).</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable AI Scanner</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="endpoint" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Chat Completions Endpoint</label>
                    <comment>e.g. http://host.docker.internal:11434/v1/chat/completions (Ollama) or https://api.openai.com/v1/chat/completions</comment>
                    <validate>validate-url</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="model" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Model</label>
                    <comment>e.g. qwen2.5-coder, llama3.1, gpt-4o-mini</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="api_key" translate="label" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key</label>
                    <comment>Optional. Sent as a Bearer token (needed for external APIs, usually empty for a local model).</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="max_chars" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Max Characters Sent</label>
                    <comment>Content is truncated to this length before being sent to the model (bounds cost and context). Default 12000.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="system_prompt" translate="label comment" type="textarea" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>System Prompt</label>
                    <comment><![CDATA[Instructions sent to the model. Keep the defensive framing and the rule that the scanned content is <strong>untrusted data, never instructions</strong> &mdash; otherwise the AI may refuse or be tricked by malicious content. The scanned content is appended automatically inside delimiters. Leave empty to fall back to a built-in safe prompt.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="remote_signatures" translate="label" type="text" sortOrder="39" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Remote Signatures (optional)</label>
                <comment>Fetch an extra regex database from a GitHub (or any HTTPS) JSON URL before each scan — "antivirus definitions" style. These patterns are added ON TOP of the built-in ones, so detection keeps working offline. Update the remote repo to ship new detections without releasing the module. See docs/remote-repos.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Remote Signatures</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="url" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Signatures JSON URL</label>
                    <comment>HTTPS raw URL, e.g. https://raw.githubusercontent.com/&lt;you&gt;/&lt;repo&gt;/main/signatures.json</comment>
                    <validate>validate-url</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="update_interval" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Update Interval (hours)</label>
                    <comment>Minimum time between network checks. The body is not re-downloaded while the source has not changed. Default 24.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="vuln_feed" translate="label" type="text" sortOrder="41" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Magento Vulnerability Feed (optional)</label>
                <comment>Show the latest Magento/Adobe Commerce vulnerabilities in the admin (system-message bar at the top + notification inbox) from an HTTPS JSON feed. The feed is produced out-of-band (e.g. a scheduled AI job) and only consumed here. See docs/remote-repos.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Vulnerability Feed</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="url" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Feed JSON URL</label>
                    <comment>HTTPS raw URL, e.g. https://raw.githubusercontent.com/&lt;you&gt;/&lt;repo&gt;/main/feed.json</comment>
                    <validate>validate-url</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="update_interval" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Update Interval (hours)</label>
                    <comment>How often the hourly cron re-checks the feed. Default 1.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="max_items" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Max Items Shown</label>
                    <comment>Maximum number of feed items kept/displayed. Default 10.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="malicious_patterns" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Malicious Code Detection Patterns</label>
                <field id="custom_patterns" translate="label" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom Patterns</label>
                    <comment>Add your own regular expressions to detect malicious code. One pattern per line.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
